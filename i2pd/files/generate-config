#!/bin/sh

set -e

OUTPUT="${1:-/var/lib/i2pd.conf}"
TMP="${OUTPUT}.tmp.$$"

# ---------------------------------------------------------------------------
# UCI helpers
# ---------------------------------------------------------------------------

uci_get() {
	local option="$1"
	local default="$2"
	local value

	value="$(uci -q get "i2pd.main.${option}" 2>/dev/null || true)"

	if [ -n "$value" ]; then
		printf '%s' "$value"
	else
		printf '%s' "$default"
	fi
}

uci_get_optional() {
	local option="$1"
	local value

	value="$(uci -q get "i2pd.main.${option}" 2>/dev/null || true)"

	printf '%s' "$value"
}

emit() {
	local key="$1"
	local value="$2"

	printf '%s = %s\n' "$key" "$value" >> "$TMP"
}

emit_optional() {
	local key="$1"
	local value="$2"

	[ -n "$value" ] || return 0

	printf '%s = %s\n' "$key" "$value" >> "$TMP"
}

emit_bool() {
	local key="$1"
	local value="$2"

	case "$value" in
		1|true|yes|on)
			printf '%s = true\n' "$key" >> "$TMP"
			;;
		0|false|no|off)
			printf '%s = false\n' "$key" >> "$TMP"
			;;
		*)
			# Keep invalid/unknown UCI values from producing invalid
			# boolean syntax. Treat them as false.
			printf '%s = false\n' "$key" >> "$TMP"
			;;
	esac
}

# ---------------------------------------------------------------------------
# Prepare output directory
# ---------------------------------------------------------------------------

OUTPUT_DIR="${OUTPUT%/*}"

if [ "$OUTPUT_DIR" = "$OUTPUT" ]; then
	OUTPUT_DIR="."
fi

mkdir -p "$OUTPUT_DIR"

rm -f "$TMP"

# ---------------------------------------------------------------------------
# Global configuration
# ---------------------------------------------------------------------------

emit_optional "tunconf" \
	"$(uci_get_optional tunconf)"

emit_optional "tunnelsdir" \
	"$(uci_get tunnelsdir "/etc/i2pd/tunnels.d")"

emit_optional "certsdir" \
	"$(uci_get certsdir "/usr/share/i2pd/certificates")"

emit_optional "pidfile" \
	"$(uci_get pidfile "/var/run/i2pd.pid")"

emit "log" \
	"$(uci_get log "stdout")"

emit_optional "logfile" \
	"$(uci_get logfile "/var/log/i2pd/i2pd.log")"

emit "loglevel" \
	"$(uci_get loglevel "info")"

emit_bool "logclftime" \
	"$(uci_get logclftime "0")"

# IMPORTANT:
# i2pd is managed by procd, therefore daemon mode must remain disabled.
emit_bool "daemon" \
	"$(uci_get daemon "0")"

emit_optional "family" \
	"$(uci_get_optional family)"

emit_optional "ifname" \
	"$(uci_get_optional ifname)"

emit_optional "ifname4" \
	"$(uci_get_optional ifname4)"

emit_optional "ifname6" \
	"$(uci_get_optional ifname6)"

emit_optional "address4" \
	"$(uci_get_optional address4)"

emit_optional "address6" \
	"$(uci_get_optional address6)"

emit_optional "host" \
	"$(uci_get_optional host)"

emit_optional "port" \
	"$(uci_get_optional port)"

emit_bool "ipv4" \
	"$(uci_get ipv4 "1")"

emit_bool "ipv6" \
	"$(uci_get ipv6 "0")"

emit_bool "nat" \
	"$(uci_get nat "0")"

emit_bool "reservedrange" \
	"$(uci_get reservedrange "0")"

emit "bandwidth" \
	"$(uci_get bandwidth "L")"

emit "share" \
	"$(uci_get share "100")"

emit_bool "notransit" \
	"$(uci_get notransit "0")"

emit_bool "floodfill" \
	"$(uci_get floodfill "0")"

emit_bool "stan" \
	"$(uci_get stan "0")"

# ---------------------------------------------------------------------------
# NTCP2
# ---------------------------------------------------------------------------

printf '\n[ntcp2]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get ntcp2_enabled "1")"

emit_bool "published" \
	"$(uci_get ntcp2_published "1")"

emit_optional "port" \
	"$(uci_get_optional ntcp2_port)"

# ---------------------------------------------------------------------------
# SSU2
# ---------------------------------------------------------------------------

printf '\n[ssu2]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get ssu2_enabled "1")"

emit_bool "published" \
	"$(uci_get ssu2_published "1")"

emit_optional "port" \
	"$(uci_get_optional ssu2_port)"

# ---------------------------------------------------------------------------
# HTTP Web Console
# ---------------------------------------------------------------------------

printf '\n[http]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get http_enabled "1")"

emit "address" \
	"$(uci_get http_address "127.0.0.1")"

emit "port" \
	"$(uci_get http_port "7070")"

emit "webroot" \
	"$(uci_get http_webroot "/")"

emit_bool "auth" \
	"$(uci_get http_auth "0")"

emit "user" \
	"$(uci_get http_user "i2pd")"

emit "pass" \
	"$(uci_get http_pass "changeme")"

emit "lang" \
	"$(uci_get http_lang "english")"

# ---------------------------------------------------------------------------
# HTTP Proxy
# ---------------------------------------------------------------------------

printf '\n[httpproxy]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get httpproxy_enabled "1")"

emit "address" \
	"$(uci_get httpproxy_address "127.0.0.1")"

emit "port" \
	"$(uci_get httpproxy_port "4444")"

emit "keys" \
	"$(uci_get httpproxy_keys "http-proxy-keys.dat")"

emit_bool "addresshelper" \
	"$(uci_get httpproxy_addresshelper "1")"

emit_optional "outproxy" \
	"$(uci_get_optional httpproxy_outproxy)"

# ---------------------------------------------------------------------------
# SOCKS Proxy
# ---------------------------------------------------------------------------

printf '\n[socksproxy]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get socksproxy_enabled "1")"

emit "address" \
	"$(uci_get socksproxy_address "127.0.0.1")"

emit "port" \
	"$(uci_get socksproxy_port "4447")"

emit "keys" \
	"$(uci_get socksproxy_keys "socks-proxy-keys.dat")"

# i2pd syntax is:
#   outproxy.enabled = false
#
# not:
#   outproxy_enabled = false
emit_bool "outproxy.enabled" \
	"$(uci_get socksproxy_outproxy_enabled "0")"

emit_optional "outproxy" \
	"$(uci_get_optional socksproxy_outproxy)"

emit_optional "outproxyport" \
	"$(uci_get_optional socksproxy_outproxyport)"

# ---------------------------------------------------------------------------
# SAM
# ---------------------------------------------------------------------------

printf '\n[sam]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get sam_enabled "0")"

emit "address" \
	"$(uci_get sam_address "127.0.0.1")"

emit "port" \
	"$(uci_get sam_port "7656")"

emit "portudp" \
	"$(uci_get sam_portudp "7655")"

# ---------------------------------------------------------------------------
# BOB
# ---------------------------------------------------------------------------

printf '\n[bob]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get bob_enabled "0")"

emit "address" \
	"$(uci_get bob_address "127.0.0.1")"

emit "port" \
	"$(uci_get bob_port "2827")"

# ---------------------------------------------------------------------------
# I2CP
# ---------------------------------------------------------------------------

printf '\n[i2cp]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get i2cp_enabled "0")"

emit "address" \
	"$(uci_get i2cp_address "127.0.0.1")"

emit "port" \
	"$(uci_get i2cp_port "7654")"

# ---------------------------------------------------------------------------
# I2PControl
# ---------------------------------------------------------------------------

printf '\n[i2pcontrol]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get i2pcontrol_enabled "0")"

emit "address" \
	"$(uci_get i2pcontrol_address "127.0.0.1")"

emit "port" \
	"$(uci_get i2pcontrol_port "7650")"

emit "password" \
	"$(uci_get i2pcontrol_password "itoopie")"

# ---------------------------------------------------------------------------
# ElGamal precomputation
# ---------------------------------------------------------------------------

printf '\n[precomputation]\n' >> "$TMP"

emit_bool "elgamal" \
	"$(uci_get precomputation_elgamal "0")"

# ---------------------------------------------------------------------------
# UPnP
# ---------------------------------------------------------------------------

printf '\n[upnp]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get upnp_enabled "0")"

emit "name" \
	"$(uci_get upnp_name "I2Pd")"

# ---------------------------------------------------------------------------
# Yggdrasil / mesh networks
# ---------------------------------------------------------------------------

printf '\n[meshnets]\n' >> "$TMP"

emit_bool "yggdrasil" \
	"$(uci_get meshnets_yggdrasil "0")"

emit_optional "yggaddress" \
	"$(uci_get_optional meshnets_yggaddress)"

# ---------------------------------------------------------------------------
# Reseed
# ---------------------------------------------------------------------------

printf '\n[reseed]\n' >> "$TMP"

emit_bool "verify" \
	"$(uci_get reseed_verify "1")"

emit_optional "urls" \
	"$(uci_get reseed_urls \
		"https://reseed.i2p-projekt.de/,https://i2p.mooo.com/netDb/,https://netdb.i2p2.no/")"

emit_optional "yggurls" \
	"$(uci_get reseed_yggurls \
		"http://[324:71e:281a:9ed3::ace]:7070/")"

emit_optional "file" \
	"$(uci_get_optional reseed_file)"

emit_optional "zipfile" \
	"$(uci_get_optional reseed_zipfile)"

emit_optional "proxy" \
	"$(uci_get_optional reseed_proxy)"

emit "threshold" \
	"$(uci_get reseed_threshold "25")"

emit_bool "followredirect" \
	"$(uci_get reseed_followredirect "0")"

# ---------------------------------------------------------------------------
# AddressBook
# ---------------------------------------------------------------------------

printf '\n[addressbook]\n' >> "$TMP"

emit_optional "defaulturl" \
	"$(uci_get addressbook_defaulturl \
		"http://shx5vqsw7usdaunyzr2qmes2fq37oumybpudrd4jjj4e4vk4uusa.b32.i2p/hosts.txt")"

emit_optional "subscriptions" \
	"$(uci_get addressbook_subscriptions \
		"http://reg.i2p/hosts.txt,http://identiguy.i2p/hosts.txt,http://stats.i2p/cgi-bin/newhosts.txt")"

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

printf '\n[limits]\n' >> "$TMP"

emit "transittunnels" \
	"$(uci_get limits_transittunnels "25000")"

emit "openfiles" \
	"$(uci_get limits_openfiles "0")"

emit "coresize" \
	"$(uci_get limits_coresize "0")"

# ---------------------------------------------------------------------------
# Trust
# ---------------------------------------------------------------------------

printf '\n[trust]\n' >> "$TMP"

emit_bool "enabled" \
	"$(uci_get trust_enabled "0")"

emit_optional "family" \
	"$(uci_get_optional trust_family)"

emit_optional "routers" \
	"$(uci_get_optional trust_routers)"

emit_bool "hidden" \
	"$(uci_get trust_hidden "0")"

# ---------------------------------------------------------------------------
# Exploratory tunnels
# ---------------------------------------------------------------------------

printf '\n[exploratory]\n' >> "$TMP"

emit "inbound.length" \
	"$(uci_get exploratory_inbound_length "2")"

emit "inbound.quantity" \
	"$(uci_get exploratory_inbound_quantity "3")"

emit "outbound.length" \
	"$(uci_get exploratory_outbound_length "2")"

emit "outbound.quantity" \
	"$(uci_get exploratory_outbound_quantity "3")"

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

printf '\n[persist]\n' >> "$TMP"

emit_bool "profiles" \
	"$(uci_get persist_profiles "1")"

emit_bool "addressbook" \
	"$(uci_get persist_addressbook "1")"

# ---------------------------------------------------------------------------
# Install atomically
# ---------------------------------------------------------------------------

chmod 0644 "$TMP"
mv -f "$TMP" "$OUTPUT"

exit 0
