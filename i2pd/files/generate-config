#!/bin/sh

set -e

OUTPUT="${1:-/var/lib/i2pd/i2pd.conf}"
TMP="${OUTPUT}.tmp.$$"

# ---------------------------------------------------------------------------
# UCI helpers
# ---------------------------------------------------------------------------

uci_get() {
	local option="$1"
	local default="$2"
	local value

	value="$(uci -q get "i2pd.main.${option}" 2>/dev/null || true)"

	if [ -n "$value" ]; then
		printf '%s' "$value"
	else
		printf '%s' "$default"
	fi
}

uci_get_optional() {
	local option="$1"
	local value

	value="$(uci -q get "i2pd.main.${option}" 2>/dev/null || true)"

	printf '%s' "$value"
}

# Read a UCI option that may be stored as a list and return its values
# as a comma-separated string for i2pd.conf.
#
# This also keeps compatibility with the old format where the option was
# stored as a single comma-separated "option" value.
uci_get_list_csv() {
	local option="$1"
	local default="$2"
	local value
	local result=""

	# UCI can represent a list as:
	#
	#   i2pd.main.option='value1' 'value2' 'value3'
	#
	# Split the quoted elements first, then remove their quotes and join
	# them with commas for the i2pd.conf syntax.
	while IFS= read -r value; do
		[ -n "$value" ] || continue

		if [ -n "$result" ]; then
			result="${result},${value}"
		else
			result="$value"
		fi
	done <<EOF
$(uci -q show "i2pd.main.${option}" 2>/dev/null | \
	sed "s/^[^=]*=//; s/' '/\\n/g; s/^'//; s/'$//" || true)
EOF

	if [ -n "$result" ]; then
		printf '%s' "$result"
	else
		uci_get "$option" "$default"
	fi
}

emit() {
	local key="$1"
	local value="$2"

	printf '%s = %s\n' "$key" "$value" >> "$TMP"
}

emit_optional() {
	local key="$1"
	local value="$2"

	[ -n "$value" ] || return 0

	printf '%s = %s\n' "$key" "$value" >> "$TMP"
}

emit_bool() {
	local key="$1"
	local value="$2"

	case "$value" in
		1|true|yes|on)
			printf '%s = true\n' "$key" >> "$TMP"
			;;
		0|false|no|off)
			printf '%s = false\n' "$key" >> "$TMP"
			;;
		*)
			# Keep invalid/unknown UCI values from producing invalid
			# boolean syntax. Treat them as false.
			printf '%s = false\n' "$key" >> "$TMP"
			;;
	esac
}

