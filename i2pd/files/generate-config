#!/bin/sh
# Generate /tmp/i2pd.conf and active tunnel files from /etc/config/i2pd.
set -eu

OUT=/tmp/i2pd.conf
NEW=/tmp/i2pd.conf.new
TUNDIR=/etc/i2pd/tunnels.d
TUNNEW=/tmp/i2pd-tunnels.new

mkdir -p "$TUNDIR"
rm -rf "$TUNNEW"
mkdir -p "$TUNNEW"

get() {
	uci -q get "i2pd.main.$1" 2>/dev/null || true
}

emit() {
	local uci_name="$1" i2pd_name="$2" value
	value="$(get "$uci_name")"
	[ -n "$value" ] || return 0
	value="$(printf '%s' "$value" | tr '\r\n' '  ')"
	printf '%s = %s\n' "$i2pd_name" "$value"
}

section() {
	local name="$1"
	shift
	printf '\n[%s]\n' "$name"
	while [ "$#" -gt 1 ]; do
		emit "$1" "$2"
		shift 2
	done
}

{
	printf '# Generated by luci-app-i2pd. DO NOT EDIT.\n'
	printf '# Source: /etc/config/i2pd\n\n'

	for p in \
		tunconf tunnelsdir certsdir pidfile log logfile loglevel logclftime \
		daemon family ifname ifname4 ifname6 address4 address6 host port \
		reservedrange nat ipv4 ipv6 notransit floodfill bandwidth share stan netid
	do
		emit "$p" "$p"
	done

	section ntcp2 \
		ntcp2_enabled enabled ntcp2_published published ntcp2_port port \
		ntcp2_addressv6 addressv6 ntcp2_proxy proxy ntcp2_version version

	section ssu2 \
		ssu2_enabled enabled ssu2_published published ssu2_port port ssu2_proxy proxy \
		ssu2_mtu4 mtu4 ssu2_mtu6 mtu6 ssu2_firewalled4 firewalled4 \
		ssu2_firewalled6 firewalled6 ssu2_version version

	section http \
		http_enabled enabled http_address address http_port port http_webroot webroot \
		http_auth auth http_user user http_pass pass http_strictheaders strictheaders \
		http_hostname hostname http_showTotalTCSR showTotalTCSR http_lang lang http_theme theme

	section httpproxy \
		httpproxy_enabled enabled httpproxy_address address httpproxy_port port \
		httpproxy_keys keys httpproxy_signaturetype signaturetype \
		httpproxy_inbound_length inbound.length httpproxy_inbound_quantity inbound.quantity \
		httpproxy_inbound_lengthVariance inbound.lengthVariance \
		httpproxy_outbound_length outbound.length httpproxy_outbound_quantity outbound.quantity \
		httpproxy_outbound_lengthVariance outbound.lengthVariance \
		httpproxy_outproxy outproxy httpproxy_addresshelper addresshelper \
		httpproxy_senduseragent senduseragent httpproxy_i2cp_leaseSetType i2cp.leaseSetType \
		httpproxy_i2cp_leaseSetEncType i2cp.leaseSetEncType \
		httpproxy_i2cp_leaseSetPrivKey i2cp.leaseSetPrivKey \
		httpproxy_i2p_streaming_profile i2p.streaming.profile \
		httpproxy_i2p_streaming_maxWindowSize i2p.streaming.maxWindowSize \
		httpproxy_latency_min latency.min httpproxy_latency_max latency.max \
		httpproxy_i2p_streaming_maxOutboundSpeed i2p.streaming.maxOutboundSpeed \
		httpproxy_i2p_streaming_maxInboundSpeed i2p.streaming.maxInboundSpeed

	section socksproxy \
		socksproxy_enabled enabled socksproxy_address address socksproxy_port port \
		socksproxy_keys keys socksproxy_signaturetype signaturetype \
		socksproxy_inbound_length inbound.length socksproxy_inbound_quantity inbound.quantity \
		socksproxy_inbound_lengthVariance inbound.lengthVariance \
		socksproxy_outbound_length outbound.length socksproxy_outbound_quantity outbound.quantity \
		socksproxy_outbound_lengthVariance outbound.lengthVariance \
		socksproxy_outproxy_enabled outproxy.enabled socksproxy_outproxy outproxy \
		socksproxy_outproxyport outproxyport socksproxy_i2cp_leaseSetType i2cp.leaseSetType \
		socksproxy_i2cp_leaseSetEncType i2cp.leaseSetEncType \
		socksproxy_i2cp_leaseSetPrivKey i2cp.leaseSetPrivKey \
		socksproxy_i2p_streaming_profile i2p.streaming.profile \
		socksproxy_i2p_streaming_maxWindowSize i2p.streaming.maxWindowSize \
		socksproxy_latency_min latency.min socksproxy_latency_max latency.max \
		socksproxy_i2p_streaming_maxOutboundSpeed i2p.streaming.maxOutboundSpeed \
		socksproxy_i2p_streaming_maxInboundSpeed i2p.streaming.maxInboundSpeed

	section sam sam_enabled enabled sam_address address sam_port port sam_portudp portudp sam_singlethread singlethread
	section bob bob_enabled enabled bob_address address bob_port port
	section i2cp i2cp_enabled enabled i2cp_address address i2cp_port port i2cp_singlethread singlethread i2cp_inboundlimit inboundlimit i2cp_outboundlimit outboundlimit
	section i2pcontrol i2pcontrol_enabled enabled i2pcontrol_address address i2pcontrol_port port i2pcontrol_password password i2pcontrol_cert cert i2pcontrol_key key
	section precomputation precomputation_elgamal elgamal
	section upnp upnp_enabled enabled upnp_name name
	section meshnets meshnets_yggdrasil yggdrasil meshnets_yggaddress yggaddress
	section reseed reseed_verify verify reseed_urls urls reseed_yggurls yggurls reseed_file file reseed_zipfile zipfile reseed_proxy proxy reseed_threshold threshold reseed_followredirect followredirect
	section addressbook addressbook_enabled enabled addressbook_defaulturl defaulturl addressbook_subscriptions subscriptions addressbook_hostsfile hostsfile
	section limits limits_transittunnels transittunnels limits_openfiles openfiles limits_coresize coresize limits_zombies zombies
	section trust trust_enabled enabled trust_family family trust_routers routers trust_hidden hidden
	section exploratory exploratory_inbound_length inbound.length exploratory_inbound_quantity inbound.quantity exploratory_outbound_length outbound.length exploratory_outbound_quantity outbound.quantity
	section persist persist_profiles profiles persist_addressbook addressbook
	section unix unix_handle_sigtstp handle_sigtstp
} > "$NEW"

mv "$NEW" "$OUT"

rm -f "$TUNDIR"/*.conf 2>/dev/null || true

idx=0
while uci -q get "i2pd.@tunnel[$idx]" >/dev/null 2>&1; do
	name="$(uci -q get "i2pd.@tunnel[$idx].name" 2>/dev/null || true)"
	enabled="$(uci -q get "i2pd.@tunnel[$idx].enabled" 2>/dev/null || true)"
	type="$(uci -q get "i2pd.@tunnel[$idx].type" 2>/dev/null || true)"
	[ -n "$name" ] || name="tunnel-$idx"
	[ "$enabled" = "0" ] && { idx=$((idx + 1)); continue; }
	[ -n "$type" ] || { idx=$((idx + 1)); continue; }

	safe="$(printf '%s' "$name" | tr -c 'A-Za-z0-9_.-' '_')"
	[ -n "$safe" ] || safe="tunnel-$idx"
	file="$TUNNEW/$safe.conf"
	{
		printf '[%s]\n' "$name"
		printf 'type = %s\n' "$type"
		for pair in \
			"address address" "host host" "port port" "inport inport" \
			"destination destination" "destinationport destinationport" "keys keys" \
			"signaturetype signaturetype" "accesslist accesslist" \
			"inbound_length inbound.length" "inbound_quantity inbound.quantity" \
			"inbound_lengthVariance inbound.lengthVariance" \
			"outbound_length outbound.length" "outbound_quantity outbound.quantity" \
			"outbound_lengthVariance outbound.lengthVariance" \
			"i2cp_leaseSetType i2cp.leaseSetType" "i2cp_leaseSetEncType i2cp.leaseSetEncType" \
			"i2cp_leaseSetPrivKey i2cp.leaseSetPrivKey" \
			"i2p_streaming_profile i2p.streaming.profile" \
			"i2p_streaming_maxWindowSize i2p.streaming.maxWindowSize" \
			"i2p_streaming_maxOutboundSpeed i2p.streaming.maxOutboundSpeed" \
			"i2p_streaming_maxInboundSpeed i2p.streaming.maxInboundSpeed" \
			"latency_min latency.min" "latency_max latency.max" "outproxy outproxy" \
			"outproxyport outproxyport" "outproxy_enabled outproxy.enabled" \
			"webircpassword webircpassword"
		do
			uci_name="${pair%% *}"; i2pd_name="${pair#* }"
			value="$(uci -q get "i2pd.@tunnel[$idx].$uci_name" 2>/dev/null || true)"
			[ -n "$value" ] || continue
			value="$(printf '%s' "$value" | tr '\r\n' '  ')"
			printf '%s = %s\n' "$i2pd_name" "$value"
		done
		uci -q show "i2pd.@tunnel[$idx].extra" 2>/dev/null |
			sed -n "s/^[^=]*='\(.*\)'$/\1/p" |
			while IFS= read -r extra; do
				case "$extra" in *=*) printf '%s\n' "$extra";; esac
			done
	} > "$file"
	mv "$file" "$TUNDIR/"
	chown i2pd:i2pd "$TUNDIR/$(basename "$file")"
	chmod 0644 "$TUNDIR/$(basename "$file")"
	idx=$((idx + 1))
done

rm -rf "$TUNNEW"
