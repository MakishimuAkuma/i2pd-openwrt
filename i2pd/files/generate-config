#!/bin/sh

set -eu

OUT="/tmp/i2pd.conf"
TMP="${OUT}.tmp"
TUNNEL_DIR="/etc/i2pd/tunnels.d"

config_load i2pd

get() {
	local cfg="$1"
	local option="$2"
	local default="${3:-}"
	local value

	config_get value "$cfg" "$option" "$default"
	printf '%s' "$value"
}

normalize_bool() {
	case "$1" in
		1|true|yes|on|enabled)
			printf 'true'
			;;
		0|false|no|off|disabled|'')
			printf 'false'
			;;
		*)
			printf '%s' "$1"
			;;
	esac
}

emit() {
	local name="$1"
	local value="$2"

	[ -n "$value" ] || return 0

	printf '%s = %s\n' "$name" "$value" >> "$TMP"
}

emit_bool() {
	local name="$1"
	local value="$2"

	[ -n "$value" ] || return 0

	printf '%s = %s\n' "$name" "$(normalize_bool "$value")" >> "$TMP"
}

emit_any() {
	local name="$1"
	local value="$2"

	[ -n "$value" ] || return 0

	printf '%s = %s\n' "$name" "$value" >> "$TMP"
}

section() {
	printf '\n[%s]\n' "$1" >> "$TMP"
}

section_global() {
	printf '# Generated by /usr/libexec/i2pd/generate-config\n\n' > "$TMP"
}

generate_main() {
	local cfg="$1"

	section_global

	#
	# OpenWrt / filesystem
	#
	emit tunconf "$(get "$cfg" tunconf)"
	emit tunnelsdir "$(get "$cfg" tunnelsdir)"
	emit certsdir "$(get "$cfg" certsdir)"
	emit pidfile "$(get "$cfg" pidfile)"

	#
	# Logging
	#
	emit log "$(get "$cfg" log)"
	emit logfile "$(get "$cfg" logfile)"
	emit loglevel "$(get "$cfg" loglevel)"
	emit_bool logclftime "$(get "$cfg" logclftime)"

	#
	# Process
	#
	emit_bool daemon "$(get "$cfg" daemon)"

	#
	# Network
	#
	emit family "$(get "$cfg" family)"
	emit ifname "$(get "$cfg" ifname)"
	emit ifname4 "$(get "$cfg" ifname4)"
	emit ifname6 "$(get "$cfg" ifname6)"
	emit address4 "$(get "$cfg" address4)"
	emit address6 "$(get "$cfg" address6)"
	emit host "$(get "$cfg" host)"
	emit port "$(get "$cfg" port)"

	emit_bool ipv4 "$(get "$cfg" ipv4)"
	emit_bool ipv6 "$(get "$cfg" ipv6)"

	#
	# NAT / transport
	#
	emit_bool nat "$(get "$cfg" nat)"
	emit_bool reservedrange "$(get "$cfg" reservedrange)"

	#
	# Bandwidth
	#
	emit bandwidth "$(get "$cfg" bandwidth)"
	emit share "$(get "$cfg" share)"

	#
	# Router mode
	#
	emit_bool notransit "$(get "$cfg" notransit)"
	emit_bool floodfill "$(get "$cfg" floodfill)"
	emit_bool stan "$(get "$cfg" stan)"
}

generate_ntcp2() {
	local cfg="$1"

	section ntcp2

	emit_bool enabled "$(get "$cfg" ntcp2_enabled)"
	emit_bool published "$(get "$cfg" ntcp2_published)"
	emit port "$(get "$cfg" ntcp2_port)"
}

generate_ssu2() {
	local cfg="$1"

	section ssu2

	emit_bool enabled "$(get "$cfg" ssu2_enabled)"
	emit_bool published "$(get "$cfg" ssu2_published)"
	emit port "$(get "$cfg" ssu2_port)"
}

generate_http() {
	local cfg="$1"

	section http

	emit_bool enabled "$(get "$cfg" http_enabled)"
	emit address "$(get "$cfg" http_address)"
	emit port "$(get "$cfg" http_port)"
	emit webroot "$(get "$cfg" http_webroot)"
	emit_bool auth "$(get "$cfg" http_auth)"
	emit user "$(get "$cfg" http_user)"
	emit pass "$(get "$cfg" http_pass)"
	emit lang "$(get "$cfg" http_lang)"
}

generate_httpproxy() {
	local cfg="$1"

	section httpproxy

	emit_bool enabled "$(get "$cfg" httpproxy_enabled)"
	emit address "$(get "$cfg" httpproxy_address)"
	emit port "$(get "$cfg" httpproxy_port)"
	emit keys "$(get "$cfg" httpproxy_keys)"
	emit_bool addresshelper "$(get "$cfg" httpproxy_addresshelper)"
	emit outproxy "$(get "$cfg" httpproxy_outproxy)"
}

generate_socksproxy() {
	local cfg="$1"

	section socksproxy

	emit_bool enabled "$(get "$cfg" socksproxy_enabled)"
	emit address "$(get "$cfg" socksproxy_address)"
	emit port "$(get "$cfg" socksproxy_port)"
	emit keys "$(get "$cfg" socksproxy_keys)"

	#
	# i2pd expects:
	#
	# outproxy.enabled = false
	#
	if [ -n "$(get "$cfg" socksproxy_outproxy_enabled)" ]; then
		emit_bool "outproxy.enabled" \
			"$(get "$cfg" socksproxy_outproxy_enabled)"
	fi

	emit outproxy "$(get "$cfg" socksproxy_outproxy)"
	emit outproxyport "$(get "$cfg" socksproxy_outproxyport)"
}

generate_sam() {
	local cfg="$1"

	section sam

	emit_bool enabled "$(get "$cfg" sam_enabled)"
	emit address "$(get "$cfg" sam_address)"
	emit port "$(get "$cfg" sam_port)"
	emit portudp "$(get "$cfg" sam_portudp)"
}

generate_bob() {
	local cfg="$1"

	section bob

	emit_bool enabled "$(get "$cfg" bob_enabled)"
	emit address "$(get "$cfg" bob_address)"
	emit port "$(get "$cfg" bob_port)"
}

generate_i2cp() {
	local cfg="$1"

	section i2cp

	emit_bool enabled "$(get "$cfg" i2cp_enabled)"
	emit address "$(get "$cfg" i2cp_address)"
	emit port "$(get "$cfg" i2cp_port)"
}

generate_i2pcontrol() {
	local cfg="$1"

	section i2pcontrol

	emit_bool enabled "$(get "$cfg" i2pcontrol_enabled)"
	emit address "$(get "$cfg" i2pcontrol_address)"
	emit port "$(get "$cfg" i2pcontrol_port)"
	emit password "$(get "$cfg" i2pcontrol_password)"
}

generate_precomputation() {
	local cfg="$1"

	section precomputation

	emit_bool elgamal "$(get "$cfg" precomputation_elgamal)"
}

generate_upnp() {
	local cfg="$1"

	section upnp

	emit_bool enabled "$(get "$cfg" upnp_enabled)"
	emit name "$(get "$cfg" upnp_name)"
}

generate_meshnets() {
	local cfg="$1"

	section meshnets

	emit_bool yggdrasil "$(get "$cfg" meshnets_yggdrasil)"
	emit yggaddress "$(get "$cfg" meshnets_yggaddress)"
}

generate_reseed() {
	local cfg="$1"

	section reseed

	emit_bool verify "$(get "$cfg" reseed_verify)"
	emit urls "$(get "$cfg" reseed_urls)"
	emit yggurls "$(get "$cfg" reseed_yggurls)"
	emit file "$(get "$cfg" reseed_file)"
	emit zipfile "$(get "$cfg" reseed_zipfile)"
	emit proxy "$(get "$cfg" reseed_proxy)"
	emit threshold "$(get "$cfg" reseed_threshold)"
	emit_bool followredirect "$(get "$cfg" reseed_followredirect)"
}

generate_addressbook() {
	local cfg="$1"

	section addressbook

	emit defaulturl "$(get "$cfg" addressbook_defaulturl)"
	emit subscriptions "$(get "$cfg" addressbook_subscriptions)"
}

generate_limits() {
	local cfg="$1"

	section limits

	emit transittunnels "$(get "$cfg" limits_transittunnels)"
	emit openfiles "$(get "$cfg" limits_openfiles)"
	emit coresize "$(get "$cfg" limits_coresize)"
}

generate_trust() {
	local cfg="$1"

	section trust

	emit_bool enabled "$(get "$cfg" trust_enabled)"
	emit family "$(get "$cfg" trust_family)"
	emit routers "$(get "$cfg" trust_routers)"
	emit_bool hidden "$(get "$cfg" trust_hidden)"
}

generate_exploratory() {
	local cfg="$1"

	section exploratory

	emit "inbound.length" \
		"$(get "$cfg" exploratory_inbound_length)"

	emit "inbound.quantity" \
		"$(get "$cfg" exploratory_inbound_quantity)"

	emit "outbound.length" \
		"$(get "$cfg" exploratory_outbound_length)"

	emit "outbound.quantity" \
		"$(get "$cfg" exploratory_outbound_quantity)"
}

generate_persist() {
	local cfg="$1"

	section persist

	emit_bool profiles "$(get "$cfg" persist_profiles)"
	emit_bool addressbook "$(get "$cfg" persist_addressbook)"
}

#
# Tunnel configuration
#
generate_tunnels() {
	local cfg="$1"

	mkdir -p "$TUNNEL_DIR"

	#
	# Remove old generated tunnel configs.
	#
	find "$TUNNEL_DIR" -type f -name '*.conf' -delete

	config_foreach generate_tunnel tunnel
}

generate_tunnel() {
	local cfg="$1"
	local name enabled type filename

	config_get name "$cfg" name "$cfg"
	config_get enabled "$cfg" enabled '1'
	config_get type "$cfg" type 'http'

	[ "$enabled" = "1" ] ||
		[ "$enabled" = "true" ] ||
		[ "$enabled" = "yes" ] ||
		return 0

	filename="$TUNNEL_DIR/$name.conf"

	{
		printf '[%s]\n' "$name"
		printf 'type = %s\n' "$type"

		emit_tunnel_option "$cfg" address
		emit_tunnel_option "$cfg" port
		emit_tunnel_option "$cfg" destination
		emit_tunnel_option "$cfg" destinationport
		emit_tunnel_option "$cfg" keys
		emit_tunnel_option "$cfg" host
		emit_tunnel_option "$cfg" inbound.length
		emit_tunnel_option "$cfg" inbound.quantity
		emit_tunnel_option "$cfg" inbound.nickname
		emit_tunnel_option "$cfg" outbound.length
		emit_tunnel_option "$cfg" outbound.quantity
		emit_tunnel_option "$cfg" outbound.nickname
		emit_tunnel_option "$cfg" latency
		emit_tunnel_option "$cfg" reduce
		emit_tunnel_option "$cfg" leaseSetType
		emit_tunnel_option "$cfg" gzip
		emit_tunnel_option "$cfg" proxy
		emit_tunnel_option "$cfg" proxyport
		emit_tunnel_option "$cfg" ssl
		emit_tunnel_option "$cfg" outproxy
		emit_tunnel_option "$cfg" outproxyport
	} > "$filename"

	chown i2pd:i2pd "$filename" 2>/dev/null || true
	chmod 0644 "$filename"
}

emit_tunnel_option() {
	local cfg="$1"
	local option="$2"
	local value

	config_get value "$cfg" "$option"

	[ -n "$value" ] ||
		return 0

	printf '%s = %s\n' "$option" "$value"
}

#
# Main
#
main() {
	local cfg

	cfg="$(uci -q show i2pd 2>/dev/null | sed -n "s/^i2pd\.\([^=]*\)=i2pd$/\1/p" | head -n 1)"

	[ -n "$cfg" ] ||
		cfg="main"

	generate_main "$cfg"
	generate_ntcp2 "$cfg"
	generate_ssu2 "$cfg"
	generate_http "$cfg"
	generate_httpproxy "$cfg"
	generate_socksproxy "$cfg"
	generate_sam "$cfg"
	generate_bob "$cfg"
	generate_i2cp "$cfg"
	generate_i2pcontrol "$cfg"
	generate_precomputation "$cfg"
	generate_upnp "$cfg"
	generate_meshnets "$cfg"
	generate_reseed "$cfg"
	generate_addressbook "$cfg"
	generate_limits "$cfg"
	generate_trust "$cfg"
	generate_exploratory "$cfg"
	generate_persist "$cfg"

	generate_tunnels

	mv "$TMP" "$OUT"
	chmod 0644 "$OUT"
}

main "$@"
