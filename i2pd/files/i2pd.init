#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

PROG=/usr/bin/i2pd
USER=i2pd
GROUP=i2pd
PIDFILE=/var/run/i2pd.pid
DATADIR=/var/lib/i2pd
RUNTIMECONF=/var/lib/i2pd.conf
TUNDIR=/etc/i2pd/tunnels.d
CERTSDIR=/usr/share/i2pd/certificates

start_instance() {
	local cfg="$1"
	local data_dir netdb_dir addressbook_dir

	config_get data_dir "$cfg" data_dir "$DATADIR"
	config_get netdb_dir "$cfg" netdb_dir ""
	config_get addressbook_dir "$cfg" addressbook_dir ""

	[ -n "$data_dir" ] || data_dir="$DATADIR"

	# Main data directory
	mkdir -p "$data_dir" || return 1
	chown "$USER:$GROUP" "$data_dir" || return 1

	# Tunnels
	mkdir -p "$TUNDIR" || return 1
	chown -R "$USER:$GROUP" "$TUNDIR" || return 1

	# NetDB
	if [ -n "$netdb_dir" ]; then
		mkdir -p "$netdb_dir" || return 1
		chown "$USER:$GROUP" "$netdb_dir" || return 1

		# If NetDB is already inside data_dir, use it directly.
		case "$netdb_dir" in
			"$data_dir"|"$data_dir"/*)
				;;
			*)
				if [ -e "$data_dir/netDb" ] && [ ! -L "$data_dir/netDb" ]; then
					rm -rf "$data_dir/netDb"
				fi

				ln -sfn "$netdb_dir" "$data_dir/netDb"
				;;
		esac
	else
		mkdir -p "$data_dir/netDb" || return 1
		chown "$USER:$GROUP" "$data_dir/netDb" || return 1
	fi

	# Addressbook
	if [ -n "$addressbook_dir" ]; then
		mkdir -p "$addressbook_dir" || return 1
		chown "$USER:$GROUP" "$addressbook_dir" || return 1

		# If Addressbook is already inside data_dir, use it directly.
		case "$addressbook_dir" in
			"$data_dir"|"$data_dir"/*)
				;;
			*)
				if [ -e "$data_dir/addressbook" ] && [ ! -L "$data_dir/addressbook" ]; then
					rm -rf "$data_dir/addressbook"
				fi

				ln -sfn "$addressbook_dir" "$data_dir/addressbook"
				;;
		esac
	else
		mkdir -p "$data_dir/addressbook" || return 1
		chown "$USER:$GROUP" "$data_dir/addressbook" || return 1
	fi

	# Certificates
	rm -rf "$data_dir/certificates"
	ln -s /usr/share/i2pd/certificates "$data_dir/certificates"

	/usr/libexec/i2pd/generate-config "$RUNTIMECONF" || return 1

	[ -r "$RUNTIMECONF" ] || {
		logger -t i2pd "missing generated config: $RUNTIMECONF"
		return 1
	}

	touch "$PIDFILE"
	chown "$USER:$GROUP" "$PIDFILE"

	procd_open_instance
	procd_set_param command "$PROG" --datadir="$data_dir" --conf="$RUNTIMECONF" --pidfile "$PIDFILE"
	procd_set_param env HOME="$data_dir"
	procd_set_param limits nofile=4096
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param user "$USER"
	procd_set_param group "$GROUP"
	procd_set_param pidfile "$PIDFILE"
	procd_set_param respawn
	procd_close_instance
}

start_service() {
	config_load i2pd
	config_foreach start_instance i2pd
}

stop_service() {
	rm -f "$RUNTIMECONF"
}

reload_service() {
	/usr/libexec/i2pd/generate-config || return 1
	procd_send_signal i2pd
}
